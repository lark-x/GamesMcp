{
  "name": "game-intelligence-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Evidence-first narrative knowledge platform for Genshin Impact.",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=22 <26"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "predev": "node --import tsx scripts/check-data-storage.ts",
    "dev": "node --import tsx scripts/start-dev.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run",
    "test:db": "node --import tsx scripts/test-database.ts",
    "test:candidate-flow": "node --import tsx scripts/test-release-candidate-flow.ts",
    "test:candidate-flow:local": "node --import tsx scripts/with-disposable-test-db.ts scripts/test-release-candidate-flow.ts",
    "test:performance:story": "node --import tsx scripts/with-disposable-test-db.ts scripts/test-performance-story.ts",
    "test:acquisition": "node --import tsx scripts/test-acquisition-review.ts",
    "test:backup-gate": "node --import tsx scripts/test-backup-gate.ts",
    "test:storage": "node --import tsx scripts/check-data-storage.test.ts",
    "db:up": "node --import tsx scripts/start-postgres.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "eval:retrieval": "node --import tsx scripts/evaluate-retrieval.ts",
    "eval:search-core": "node --import tsx scripts/evaluate-search-core.ts",
    "eval:search-regression": "node --import tsx scripts/evaluate-search-regression.ts",
    "eval:mcp-story": "node --import tsx scripts/evaluate-mcp-story.ts",
    "eval:mcp-story:partial": "node --import tsx scripts/evaluate-mcp-story.ts --allow-partial",
    "golden:expand": "node --import tsx scripts/expand-golden-dataset.ts",
    "eval:mcp-tools": "node --import tsx scripts/evaluate-mcp-tools.ts",
    "eval:qa": "node --import tsx scripts/evaluate-qa.ts",
    "test:istaroth-provider": "node --import tsx scripts/test-istaroth-provider.ts",
    "bootstrap:istaroth": "sh scripts/bootstrap-istaroth.sh",
    "check:istaroth-health": "node --import tsx scripts/check-istaroth-health.ts",
    "data:starrail:inventory": "node --import tsx scripts/prepare-starrail-source.ts",
    "test:starrail-provider": "node --import tsx scripts/test-starrail-provider.ts",
    "benchmark:provider": "node --import tsx scripts/benchmark-provider.ts",
    "benchmark:search": "node --import tsx scripts/benchmark-search.ts",
    "data:convert:anime": "node --import tsx scripts/convert-anime-game-data.ts",
    "data:convert:anime-quests": "node --import tsx scripts/anime-game-data-quest-converter.ts",
    "data:validate:genshin-db": "node --import tsx scripts/validate-genshin-db-import.ts",
    "data:import:anime": "node --import tsx scripts/import-anime-game-data.ts",
    "data:prepare:candidate": "node --import tsx scripts/prepare-anime-game-data-candidate.ts",
    "data:verify:anime": "node --import tsx scripts/verify-anime-game-data.ts",
    "data:status:anime": "node --import tsx scripts/report-acquisition-status.ts",
    "data:status:anime:write": "node --import tsx scripts/report-acquisition-status.ts --write",
    "data:reconcile:anime": "node --import tsx scripts/reconcile-anime-observations.ts",
    "data:checklist:anime": "node --import tsx scripts/export-anime-verification-checklist.ts",
    "data:checklist:quests": "node --import tsx scripts/export-quest-verification-checklist.ts",
    "data:backup": "node --import tsx scripts/backup-acquisition.ts",
    "data:reset:history": "node --import tsx scripts/reset-history.ts",
    "typecheck": "tsc -b",
    "db:generate": "drizzle-kit generate --config packages/database/drizzle.config.ts",
    "db:migrate": "node --import tsx packages/database/src/migrate.ts",
    "db:seed": "node --import tsx packages/database/src/seed.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@modelcontextprotocol/sdk": "^1.17.0",
    "@playwright/test": "^1.52.0",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.11.11",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@typescript-eslint/eslint-plugin": "^8.32.0",
    "@typescript-eslint/parser": "^8.32.0",
    "eslint": "^9.26.0",
    "prettier": "^3.5.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.0",
    "vitest": "^3.1.2"
  }
}
