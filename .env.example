NODE_ENV=development
HOST=127.0.0.1
API_PORT=4100
WEB_PORT=4173
DATABASE_URL=postgres://gip:gip@127.0.0.1:5432/gip
# 数据必须放在专用持久化卷。macOS 示例：/Volumes/Lark/lark/GamesMcp/data
# Windows 示例：D:/GamesMcp/data（建议 NTFS；不要使用系统盘 C:）
DATA_DIR=./data
CORS_ORIGINS=http://127.0.0.1:4173,http://localhost:4173
ADMIN_TOKEN=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL_ID=
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=2
LLM_MAX_CONTEXT_CHARS=24000
EMBEDDING_MODEL_ID=
EMBEDDING_MODEL_VERSION=
EMBEDDING_DIMENSION=1536
SEARCH_INDEX_VERSION=1
LOCAL_RATE_LIMIT_PER_MINUTE=60
