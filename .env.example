NODE_ENV=development
HOST=127.0.0.1
API_PORT=4100
WEB_PORT=4173
DATABASE_URL=postgres://gip:gip@127.0.0.1:5432/gip
# 数据必须放在专用持久化卷。macOS 示例：/Volumes/Lark/lark/GamesMcp/data
# Windows 示例：D:/GamesMcp/data（建议 NTFS；不要使用系统盘 C:）
DATA_DIR=./data
# 如果 Docker Desktop/运行缓存也已迁移到外置盘，可声明运行卷，预检将检查该卷而不是系统数据卷。
# macOS 示例：STORAGE_RUNTIME_VOLUME_PATH=/Volumes/Lark
# Windows 示例：STORAGE_RUNTIME_VOLUME_PATH=D:/
CORS_ORIGINS=http://127.0.0.1:4173,http://localhost:4173
ADMIN_TOKEN=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL_ID=
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=2
LLM_MAX_CONTEXT_CHARS=24000
EMBEDDING_MODEL_ID=
EMBEDDING_MODEL_VERSION=
EMBEDDING_DIMENSION=1536
SEARCH_INDEX_VERSION=1
LOCAL_RATE_LIMIT_PER_MINUTE=60

# Optional external Istaroth knowledge provider. GamesMcp remains usable when disabled.
GAMESMCP_ISTAROTH_ENABLED=false
GAMESMCP_ISTAROTH_URL=http://127.0.0.1:8000/mcp
GAMESMCP_ISTAROTH_GAME_SLUG=genshin
GAMESMCP_GENSHIN_ISTAROTH_ENABLED=false
GAMESMCP_GENSHIN_ISTAROTH_URL=http://127.0.0.1:8000/mcp
GAMESMCP_PROVIDER_CONNECT_TIMEOUT_MS=3000
GAMESMCP_PROVIDER_REQUEST_TIMEOUT_MS=15000
GAMESMCP_PROVIDER_HEALTH_CACHE_MS=15000

# Formal long-running deployments should pin this to a tag or digest.
# Example during local exploration only: isundaylee/istaroth:latest
ISTAROTH_IMAGE=
ISTAROTH_MCP_LANGUAGE=CHS
ISTAROTH_DOCUMENT_STORE_SET=CHS:/data/checkpoint/chs
ISTAROTH_STARRAIL_DOCUMENT_STORE_SET=CHS:/data/checkpoint/chs
ISTAROTH_TRAINING_DEVICE=cpu
ISTAROTH_CHECKPOINT_IDENTITY=

# Optional StarRail local dataset provider. Point this at an external checkout of
# https://github.com/DimbreathBot/TurnBasedGameData; do not vendor raw data here.
GAMESMCP_STARRAIL_ENABLED=false
GAMESMCP_STARRAIL_PROVIDER=local
GAMESMCP_STARRAIL_DATA_DIR=
GAMESMCP_STARRAIL_ISTAROTH_URL=http://127.0.0.1:8001/mcp
